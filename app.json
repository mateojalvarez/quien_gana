{
  "expo": {
    "name": "Quien gana",
    "slug": "quien-gana",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icono/icono-tinta.png",
    "scheme": "quiengana",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mateoalvarez.quiengana",
      "buildNumber": "1",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "¿Quién gana?",
        "CFBundleDevelopmentRegion": "es",
        "CFBundleLocalizations": [
          "es"
        ],
        "NSSupportsLiveActivities": true,
        "NSLocalNetworkUsageDescription": "Para encontrar salas del Pulsador en tu misma red wifi.",
        "NSBonjourServices": [
          "_quiengana._tcp"
        ],
        "NSAlarmKitUsageDescription": "Para que el reloj suene y vibre fuerte al terminar, aunque el teléfono esté bloqueado o en silencio."
      },
      "appleTeamId": "X77V463WTL",
      "associatedDomains": [
        "applinks:quien-gana.app"
      ],
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.mateoalvarez.quiengana"
        ],
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.mateoalvarez.quiengana",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#141414",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Para elegir tu foto de perfil.",
          "cameraPermission": "Para sacarte una foto de perfil."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F4EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#141414",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Para escanear el QR de una sala del Pulsador o de un torneo.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sonidos/alarma.wav"
          ],
          "enableRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d7eeec5e-75af-47fa-b14d-ec53cf90f2fe"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "owner": "mateojalvarez"
  }
}
