# Copiá a supabase/.env (no se commitea). El CLI de Supabase lo carga solo
# al hacer `supabase start` para resolver los env() de config.toml.
#
# Google Cloud → Google Auth Platform → Clients → tu cliente "Web application".
# Agregá en "Authorized redirect URIs":  http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=GOCSPX-xxxxxxxx

# Sólo si activás Apple por web (Android). Para Apple nativo en iOS no hace falta.
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
