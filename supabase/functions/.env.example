# Copiá a supabase/functions/.env para correr las Edge Functions en local.

# ── Borrado de cuenta ──
# Sin esto borra igual, pero no revoca los tokens de Apple.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=com.mateoalvarez.quiengana
# Pegá el contenido del .p8 en una sola línea con \n en los saltos
APPLE_PRIVATE_KEY=

# ── Amigo invisible ──
# `resend` en producción; `smtp` en local, que escribe en el buzón de pruebas
# de `supabase start` en vez de mandar mails de verdad.
MAIL_PROVIDER=smtp

# Resend → API Keys. El dominio de MAIL_FROM tiene que estar verificado ahí
# (SPF y DKIM): si no, Resend rechaza el envío con "domain is not verified".
RESEND_API_KEY=

MAIL_FROM=amigoinvisible@quiengana.test
MAIL_FROM_NAME=¿Quién gana?
MAIL_REPLY_TO=

# Sólo con MAIL_PROVIDER=smtp. El buzón se lee en http://127.0.0.1:54324.
# `supabase functions serve` corre adentro de Docker, así que 127.0.0.1 sería
# el propio contenedor: hay que salir por host.docker.internal.
SMTP_HOST=host.docker.internal
SMTP_PORT=54325
SMTP_TLS=starttls
SMTP_INSEGURO=true
SMTP_USER=
SMTP_PASS=

# De acá salen los dos enlaces públicos del mail: el pixel de apertura y el
# botón "marcar como recibido". Sin esto el mail va sin ninguno de los dos.
FUNCIONES_BASE_URL=http://127.0.0.1:54321/functions/v1

# El botón del mail apunta a una página del sitio, no a la función: el gateway
# de Supabase degrada a text/plain el HTML de una Edge Function. La página
# está en el repo quien-gana-web. En local no está servida, así que para probar la
# confirmación va directo a la función:
#   curl -X POST "http://127.0.0.1:54321/functions/v1/amigo-invisible-recibido?t=EL_TOKEN"
# (el token sale del enlace que trae el mail en el buzón de pruebas).
SITIO_BASE_URL=https://quien-gana.app
# `off` deja sólo el botón y saca el pixel, para quien no quiera ninguna señal
# automática. Cualquier otro valor (o vacío) lo deja prendido.
AMIGO_PIXEL=

# 32 bytes cada uno:  openssl rand -base64 32
# AMIGO_CLAVE_V1 cifra la asignación. Si se pierde, los sorteos viejos no se
# pueden reenviar nunca más. Si se filtra, se puede leer quién le tocó a quién.
AMIGO_CLAVE_V1=
# Firma los tokens públicos del mail (pixel y botón de recibido). Sin él,
# cualquiera podría fabricar aperturas o confirmaciones falsas.
AMIGO_LINK_SECRET=
