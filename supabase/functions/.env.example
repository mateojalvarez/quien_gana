# Copiá a supabase/functions/.env para que la Edge Function local pueda revocar
# tokens de Apple al borrar una cuenta. Sin esto, borra igual pero no revoca.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=com.mateoalvarez.quiengana
# Pegá el contenido del .p8 en una sola línea con \n en los saltos
APPLE_PRIVATE_KEY=
